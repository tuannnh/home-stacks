# Dragonica Chapter 5 private server (github.com/tuannnh/dragonica-docker).
# This file holds references only — never commit secrets, the repo is public.

# Address the servers advertise to players. "tailscale" = this stack's Tailscale sidecar IP
# (players join over Tailscale; the game ports are not published on the host).
PUBLIC_IP=${PUBLIC_IP:-tailscale}

# SQL Server 'sa' password (8+ chars, upper/lower/digit/symbol) and the login the game servers use.
MSSQL_SA_PASSWORD=${MSSQL_SA_PASSWORD:-}
GAME_DB_USER=${GAME_DB_USER:-dragonica}
GAME_DB_PASSWORD=${GAME_DB_PASSWORD:-}
# SQL Server memory cap in MB (Express never uses more than ~1.4 GB anyway).
MSSQL_MEMORY_LIMIT_MB=${MSSQL_MEMORY_LIMIT_MB:-2048}

# Map servers to run. Empty = all 29 (~12 GB RAM). Example for a small host:
# ch1:101,ch1:102,ch1:103,ch1:104,ch1:105,ch1:106,ch1:107,ch1:108,ch1:109,ch1:201,ch1:202,ch1:203
MAP_SERVERS=${MAP_SERVERS:-}
# 1 = also start the GM server (port 13002) for the GM Tool.
ENABLE_GM=${ENABLE_GM:-0}

# Tailscale sidecar login. Empty = open the login link from the dragonica-tailscale logs once.
TS_AUTHKEY=${TS_AUTHKEY:-}

# Image tags.
DRAGONICA_IMAGE_VERSION=${DRAGONICA_IMAGE_VERSION:-latest}
DRAGONICA_DATA_VERSION=${DRAGONICA_DATA_VERSION:-latest}
TAILSCALE_IMAGE_VERSION=${TAILSCALE_IMAGE_VERSION:-v1.102.5}
