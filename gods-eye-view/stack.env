# God's Eye View — 3D globe with live aircraft/ships/satellites/CCTV.
# Real values are injected at deploy time (Infisical / Portainer stack env).
# This file holds references only — never commit secrets, the repo is public.
# Every key is optional: with none set the app runs on keyless sources
# (Esri imagery, OSM, adsb.lol, USGS, CelesTrak, ...).
# NOTE: a LAN-visible server brokers these keys to anyone who can reach it —
# set provider-side quotas/budgets before adding paid keys.

# --- client-exposed (visible in the browser; restrict by referrer) ---
GOOGLE_MAPS_API_KEY=${GOOGLE_MAPS_API_KEY:-}
CESIUM_ION_TOKEN=${CESIUM_ION_TOKEN:-}
MAPILLARY_CLIENT_TOKEN=${MAPILLARY_CLIENT_TOKEN:-}

# --- server-side only ---
GOOGLE_MAPS_SERVER_API_KEY=${GOOGLE_MAPS_SERVER_API_KEY:-}
OPENAI_API_KEY=${OPENAI_API_KEY:-}
AISSTREAM_API_KEY=${AISSTREAM_API_KEY:-}
FIRMS_MAP_KEY=${FIRMS_MAP_KEY:-}
TOMTOM_API_KEY=${TOMTOM_API_KEY:-}
LL2_API_TOKEN=${LL2_API_TOKEN:-}
# anon = keyless OpenSky; oauth needs the client id/secret below.
OPENSKY_AUTH_MODE=${OPENSKY_AUTH_MODE:-anon}
OPENSKY_CLIENT_ID=${OPENSKY_CLIENT_ID:-}
OPENSKY_CLIENT_SECRET=${OPENSKY_CLIENT_SECRET:-}

# --- per-IP throttles on the cost-bearing endpoints (requests/min) ---
GEV_RATELIMIT_OPENAI_PER_MIN=${GEV_RATELIMIT_OPENAI_PER_MIN:-30}
GEV_RATELIMIT_GOOGLE_PER_MIN=${GEV_RATELIMIT_GOOGLE_PER_MIN:-60}

# --- HTTP ---
# IP access works as-is. Add any hostname used to reach the UI (e.g. a
# reverse-proxy domain), comma-separated, or Vite rejects the Host header.
GEV_ALLOWED_HOSTS=${GEV_ALLOWED_HOSTS:-}
TZ=${TZ:-Asia/Ho_Chi_Minh}
