# JX2 2021 Shiina offline server (github.com/tuannnh/jx2-shiina-docker).
# This file holds references only — never commit secrets, the repo is public.

# Address the GameServer tells game clients to connect to. "tailscale" = this stack's Tailscale
# sidecar IP (players join over Tailscale). An IP such as the host's LAN IP also works, but then
# the game ports must be published on the host.
EXTERNAL_IP=${EXTERNAL_IP:-tailscale}

# Tailscale sidecar login. Empty = open the login link from the jx2-shiina-tailscale logs once.
TS_AUTHKEY=${TS_AUTHKEY:-}

# Extra movement speed per character, percent added to normal speed (100 = twice as fast):
# "Lucius:100,Other:50", or "*:50" for everyone. Empty = normal speed.
SPEED_BOOST=${SPEED_BOOST:-}

# Default god mode (invincible, health/mana/stamina always full): "Lucius,Other" or "*".
GOD_MODE=${GOD_MODE:-}

# Characters who get the "GM Joy" item: an in-game menu to change speed and god mode instantly.
# Menu choices are saved on the character and override SPEED_BOOST / GOD_MODE.
BUFF_MENU=${BUFF_MENU:-}
