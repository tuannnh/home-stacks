# --- required (set in Portainer stack env) ---
# copyparty password of copytele (same value as CP_PASS in the copytele stack)
CP_PASS=${CP_PASS:-}
# NAS_SMB_PASS (password of the OMV user "camera") is used by the volume in
# docker-compose.yml, so it only needs to be set in the Portainer stack env.

# --- optional ---
CP_URL=${CP_URL:-http://host.docker.internal:11117}
CP_DEST=${CP_DEST:-videos/camera}
# friendly folder names: lumi1.54ef44858532=living-room,lumi1.xxxx=garage
CAMERA_NAMES=${CAMERA_NAMES:-}
SCAN_INTERVAL=${SCAN_INTERVAL:-900}
SETTLE_MINUTES=${SETTLE_MINUTES:-30}
# delete source clips on the NAS this many days after their hour was uploaded (0 = never)
KEEP_DAYS=${KEEP_DAYS:-7}
MAX_PER_CYCLE=${MAX_PER_CYCLE:-4}
# copy clips off the NAS at most this fast (MB/s) so its USB disks aren't flooded
READ_MBPS=${READ_MBPS:-8}
NTFY_URL=${NTFY_URL:-http://host.docker.internal:11141/camera-archiver}
