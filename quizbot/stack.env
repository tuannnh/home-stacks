# QuizBot — screenshot-to-answer server (github.com/tuannnh/quizbot).
# Real values are injected at deploy time (Infisical / Portainer stack env).
# This file holds references only — never commit secrets, the repo is public.

# --- required secrets ---
# Claude API key. The server fails to start without it (unless QUIZBOT_SOLVER=fake).
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
# Required only when the key isn't scoped to a workspace (ID starts with wrkspc_).
ANTHROPIC_WORKSPACE_ID=${ANTHROPIC_WORKSPACE_ID:-}
# Shared secret every agent / iPhone Shortcut sends with each capture.
QUIZBOT_TOKEN=${QUIZBOT_TOKEN}

# --- solver ---
# claude = real answers; fake = random answers for testing the pipeline at no cost.
QUIZBOT_SOLVER=${QUIZBOT_SOLVER:-claude}
# Default model; agents may override per capture within QUIZBOT_ALLOWED_MODELS.
QUIZBOT_MODEL=${QUIZBOT_MODEL:-claude-sonnet-5-5}
QUIZBOT_ALLOWED_MODELS=${QUIZBOT_ALLOWED_MODELS:-claude-haiku-5-5,claude-sonnet-5-5,claude-opus-5-5}
# Longest image edge sent to the model (smaller = faster, less legible).
QUIZBOT_MAX_EDGE=${QUIZBOT_MAX_EDGE:-1568}

QUIZBOT_LOG_LEVEL=${QUIZBOT_LOG_LEVEL:-INFO}
TZ=${TZ:-Asia/Ho_Chi_Minh}
