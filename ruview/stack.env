# RuView (wifi-densepose) — WiFi CSI presence/motion sensing server.
# Real values are injected at deploy time (Infisical / Portainer stack env).
# This file holds references only — never commit secrets, the repo is public.

# --- required secrets ---
# Bearer token guarding /api/v1/*. The entrypoint REFUSES to start (exit 64)
# when this is unset and the bind address is 0.0.0.0, because /ws/sensing
# streams live occupancy data.
RUVIEW_API_TOKEN=${RUVIEW_API_TOKEN}
# RuField signing key, 64-hex. Unset falls back to a shared deterministic
# dev key and logs a warning.
WDP_RUFIELD_SIGNING_SEED=${WDP_RUFIELD_SIGNING_SEED}

# --- CSI data plane ---
# esp32 = listen for UDP CSI frames from the nodes.
# `auto` fails loud with no hardware; `simulated` is synthetic and opt-in only.
CSI_SOURCE=${CSI_SOURCE:-esp32}
# The receiver defaults to 127.0.0.1, which makes the published UDP port
# silently deliver nothing. A routable bind requires an allowlist below.
RUVIEW_UDP_BIND=${RUVIEW_UDP_BIND:-0.0.0.0}
# Source allowlist for inbound CSI frames — the LAN the nodes sit on.
RUVIEW_UDP_ALLOW=${RUVIEW_UDP_ALLOW:-10.1.0.0/22}

# --- HTTP ---
# DNS-rebinding defence. Every host:port used to reach the UI must appear here
# or requests are rejected with HTTP 421.
SENSING_ALLOWED_HOSTS=${SENSING_ALLOWED_HOSTS:-10.1.1.99:11161,10.1.1.99,localhost:11161,127.0.0.1:11161}

RUST_LOG=${RUST_LOG:-info}
TZ=${TZ:-Asia/Ho_Chi_Minh}
