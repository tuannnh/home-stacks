# Copy to .env and fill in the tokenized RTSP URLs from the Aqara Home app.
# Aqara -> camera -> Settings -> RTSP (enable), then copy the generated URL.

DOORBELL_RTSP_URL=${DOORBELL_RTSP_URL}
DOORBELL_RTSP_USERNAME=${DOORBELL_RTSP_USERNAME}
DOORBELL_RTSP_PASSWORD=${DOORBELL_RTSP_PASSWORD}

G100_RTSP_URL=${G100_RTSP_URL}
G100_RTSP_USERNAME=${G100_RTSP_USERNAME}
G100_RTSP_PASSWORD=${G100_RTSP_PASSWORD}

