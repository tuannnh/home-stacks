# Online Arcade (github.com/tuannnh/online-arcade).
# Real values are injected at deploy time (Infisical / Portainer stack env).
# This file holds references only — never commit secrets, the repo is public.

# Password asked on the lobby screen. Empty = open to anyone who has the URL.
ARCADE_PASSWORD=${ARCADE_PASSWORD:-}

# TURN relay for friends behind strict NAT / mobile networks (black screen for guests).
# Comma-separated URLs, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URL=${TURN_URL:-}
TURN_USER=${TURN_USER:-}
TURN_PASS=${TURN_PASS:-}

# Cheat files are downloaded from the FBNeo cheat pack on first use (0 = never download).
CHEATS_DOWNLOAD=${CHEATS_DOWNLOAD:-1}

TZ=${TZ:-Asia/Ho_Chi_Minh}
